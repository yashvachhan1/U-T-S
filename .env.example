# ===== Upstox API credentials =====
# Upstox Developer Console se app banane ke baad yahan bharo
# https://account.upstox.com/developer/apps
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here

# Yeh EXACTLY wahi hona chahiye jo Upstox app me "Redirect URL" me daala hai
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Server
HOST=127.0.0.1
PORT=8000

# SAFETY: true = koi real order nahi jayega (paper trading).
# Real paise se trade karne ke liye isko false karo.
PAPER_TRADING=true

# ===== Market data =====
# FRED (St. Louis Fed) -- free key se crude, DXY, US10Y, VIX aur India EPU
# sab ek jagah milte hain. Key yahan se: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# ===== LLM agents (Phase 5) =====
# Free key: https://console.groq.com
# Ek key kaafi hai (~840 calls/day = 0.6 req/min). Kai keys chahiyein to
# GROQ_API_KEYS me comma se alag karke daalein -- ek agent ka rate limit
# doosre ko nahi chhuyega.
GROQ_API_KEY=
# GROQ_API_KEYS=key1,key2,key3

# ===== Order safety (defaults theek hain, chhedna zaroori nahi) =====
# MARKET order API par band hai, isliye LIMIT me badalta hai is band ke saath
MARKET_ORDER_BAND_PCT=0.30
# SEBI low-frequency limit 10/sec hai -- burst + rate isse neeche rehna chahiye
MAX_ORDERS_PER_SECOND=5
MAX_ORDER_BURST=3
MAX_ORDERS_PER_DAY=200
MAX_ORDER_VALUE=100000

# ===== Risk limits (Phase 6) =====
# In sab ka ek hard ceiling code me hai (config.py). Config ceiling se bahar
# ho to app START HI NAHI HOGI -- limit chupke se loose nahi hogi.
#
# Risk engine har position isi capital ke against size karta hai. Live
# trading ke liye set karna ZAROORI hai -- warna engine size karne se mana
# kar dega (guess nahi karega).
TRADING_CAPITAL=0

# Per position
MAX_RISK_PER_TRADE_PCT=1.0      # ceiling 2.0
MAX_POSITION_PCT=10.0           # ceiling 25.0

# Portfolio
MAX_OPEN_POSITIONS=5            # ceiling 10
MAX_SECTOR_EXPOSURE_PCT=30.0    # ceiling 50.0
MAX_CORRELATED_POSITIONS=2      # ek industry ke 3 stock = 1 hi bet
MAX_TOTAL_EXPOSURE_PCT=80.0     # ceiling 100.0

# Kill switches
DAILY_LOSS_HALT_PCT=3.0         # ceiling 5.0  -- sab band, din khatam
MAX_DRAWDOWN_HALT_PCT=10.0      # ceiling 20.0 -- manual restart chahiye
MAX_TRADES_PER_DAY=10           # ceiling 50
WEEKLY_LOSS_HALF_SIZE_PCT=6.0   # size aadhi
CONSECUTIVE_LOSSES_HALF_SIZE=5  # size aadhi

# Pre-trade filters
MAX_SPREAD_PCT=0.5
MIN_DAILY_VOLUME=100000
MAX_TICK_AGE_SECONDS=5          # purana tick = trade nahi
STALE_FEED_PAUSE_SECONDS=30     # naya entry band, exit allowed
ORDER_REJECT_RATE_PAUSE_PCT=20.0
EVENT_BLACKOUT_MINUTES=120      # fresh filing wale naam me naya entry nahi
NO_ENTRY_FIRST_MINUTES=15       # opening auction -- 0 karke band kar sakte hain
SQUARE_OFF_HOUR=15
SQUARE_OFF_MINUTE=15

# Cost model -- backtester ke same numbers (edge test inhi se hota hai)
BROKERAGE_PER_ORDER=20.0
SLIPPAGE_PCT=0.03
TAXES_PCT=0.12
